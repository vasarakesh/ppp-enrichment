# Local environment
config/.env

# Cursor / IDE (local workspace)
.cursor/
.cursorignore

__pycache__/
*.pyc

logs/
*.log

# PPP inputs (full CSV, chunks, exports) stay local — not pushed to GitHub.
data/input/**
!data/input/.gitkeep
!data/input/queue/
!data/input/queue/.gitkeep

data/input/*.xlsx

# Pipeline scratch — not persisted in git (scheduled jobs write only clean_github_results/)
data/output/**
!data/output/.gitkeep
