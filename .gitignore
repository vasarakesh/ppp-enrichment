# Local environment
config/.env

# Cursor / IDE (local workspace)
.cursor/
.cursorignore

__pycache__/
*.pyc

logs/
*.log

# Ignore raw large source files (only CSVs sitting directly under data/input/).
data/input/*.csv

# But DO track the split queue chunks
!data/input/queue/*.csv

data/input/*.xlsx

# Track ONLY the clean leads output files (whitelist via rules below).

# Ignore everything else in output folder
data/output/*
!data/output/.gitkeep
!data/output/clean_leads_*.csv
!data/output/Clean Leads 1000/
!data/output/Clean Leads 1000/**

# Ignore all temp/intermediate files anywhere
data/output/raw_*.csv
data/output/debug_*.csv
data/output/temp_*.csv
*.tmp
*.log
