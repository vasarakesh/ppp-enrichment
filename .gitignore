# Local environment
config/.env

# Cursor / IDE (local workspace)
.cursor/
.cursorignore

__pycache__/
*.pyc

logs/
*.log

# Ignore raw large source files (only CSVs sitting directly under data/input/).
data/input/*.csv

# But DO track the split queue chunks
!data/input/queue/*.csv

data/input/*.xlsx

# Pipeline scratch — not persisted in git (scheduled jobs write only clean_github_results/)
data/output/**
!data/output/.gitkeep
